# Copy to .env — never commit a real .env or a real API key.
# Local dev default is SQLite; production (Neon) sets a Postgres URL.
DATABASE_URL=sqlite:///./mockmate.db
# DATABASE_URL=postgresql+psycopg2://user:password@host/db?sslmode=require
# Required in production: a long random string. Encrypts stored provider keys.
MOCKMATE_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
